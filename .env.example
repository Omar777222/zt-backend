# Copia este archivo como .env y llena los valores
PORT=3000
# En local: 127.0.0.1 | En AWS: 0.0.0.0 (el Security Group limita quien entra)
HOST=127.0.0.1

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=zt-backend
JWT_AUDIENCE=zt-frontend

# IPs de proxies confiables (en AWS: loopback, IP privada del EC2 frontend)
TRUST_PROXY=loopback

SEED_USERNAME=admin
SEED_ROLE=admin
# Genera el hash con: npm run hash -- "TuPasswordSegura"  (deja las comillas simples)
SEED_PASSWORD_HASH=''
